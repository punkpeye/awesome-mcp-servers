  },
  "links": {
    "endpoint": "https://epw.tools/api/mcp"
  },
  "install": {
    "commands": [
      "uvx --from 'epwtools[mcp]' epw-tools-mcp"
    ],
    "env": [
      "EPWTOOLS_API_KEY"
    ],
    "confidence": "medium"
  },
  "transport": [
    "stdio",
    "streamable-http"
  ],
  "auth": {
    "type": "api-key",
    "notes": [
      "EPWTOOLS_API_KEY is required for file generation; lookup tools work without a key."
    ]
  },
  "clients": [
    "Claude",
    "Claude Code",
    "Cursor",
    "ChatGPT",
    "any MCP client"
  ],
